        for _ in range(n_sims):
            hs = poisson.rvs(max(1.8, h_runs + home_adv + np.random.normal(0, 0.3)))
            aws = poisson.rvs(max(1.8, a_runs + np.random.normal(0, 0.3)))
            home_scores.append(hs)
            away_scores.append(aws)
        
